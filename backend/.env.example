# UrbanEye Environment Variables

# AI Chatbot Configuration (Phase 13)
# Choose ONE of the following:

# RECOMMENDED: Google Gemini (100% FREE!)
# Get your FREE key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Alternative: OpenAI (requires billing)
# OPENAI_API_KEY=your-openai-api-key-hereI API key
# Format: sk-proj-xxxxxxxxxxxxxxxxxxxxx

# MongoDB (Atlas) connection string - never commit your real one
# MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&appName=Cluster0

# Backend port
PORT=5000
